COLUMN TABLE mycap1_db_master_businesspartner (
  NODE_KEY NVARCHAR(32) NOT NULL,
  BP_ROLE NVARCHAR(2),
  EMAIL_ADDRESS NVARCHAR(100),
  PHONE_NUMBER NVARCHAR(30),
  FAX_NUMBER NVARCHAR(32),
  WEB_ADDRESS NVARCHAR(44),
  COMPANY_NAME NVARCHAR(250),
  BP_ID NVARCHAR(2),
  ADDRESS_GUID_NODE_KEY NVARCHAR(32),
  PRIMARY KEY(NODE_KEY)
)