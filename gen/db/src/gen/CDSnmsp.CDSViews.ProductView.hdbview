VIEW CDSnmsp_CDSViews_ProductView AS SELECT
  product_0.NODE_KEY AS NODEkEY,
  product_0.PRODUCT_ID AS ProductId,
  product_0.DESCRIPTION AS Description,
  product_0.CATEGORY AS Category,
  product_0.PRICE AS Price,
  SUPPLIER_GUID_1.BP_ID AS Supplier,
  SUPPLIER_GUID_1.COMPANY_NAME AS Company,
  ADDRESS_GUID_2.COUNTRY AS Country
FROM ((mycap1_db_master_product AS product_0 LEFT JOIN mycap1_db_master_businesspartner AS SUPPLIER_GUID_1 ON product_0.SUPPLIER_GUID_NODE_KEY = SUPPLIER_GUID_1.NODE_KEY) LEFT JOIN mycap1_db_master_address AS ADDRESS_GUID_2 ON SUPPLIER_GUID_1.ADDRESS_GUID_NODE_KEY = ADDRESS_GUID_2.NODE_KEY)